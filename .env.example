# Local development only. Copy to .env; never commit secrets.
POSTGRES_DB=finsight
POSTGRES_USER=finsight_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
QDRANT_PORT=6333
REDIS_PORT=6379
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Local development configuration. The selected answer model runs in local Ollama.
DATABASE_URL=
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0
LLM_PROVIDER=ollama
LLM_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
